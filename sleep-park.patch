+// park cache: with it on, llama_model_free parks a loaded model instead of deleting it, and the next
+// llama_model_load_from_file of the same file and placement gets it back (llama-server --sleep-park)
+static struct {
+    std::mutex mutex;
+    bool enabled     = false;
+    bool keep_pinned = false;
+    std::vector<llama_model *> models;
+} g_park_cache;
+
+void llama_model_park_cache_set(bool enable, bool keep_pinned) {
+    std::lock_guard<std::mutex> lock(g_park_cache.mutex);
+    g_park_cache.enabled     = enable;
+    g_park_cache.keep_pinned = keep_pinned;
+}
+
+static std::string llama_park_key_path(const std::string & key) {
+    return key.substr(0, key.find('|'));
+}
+
+bool llama_model_is_woken(const llama_model * model) {
+    return model->woken;
+}
+
+bool llama_model_park_cache_has(const char * path_model) {
+    std::lock_guard<std::mutex> lock(g_park_cache.mutex);
+    for (llama_model * model : g_park_cache.models) {
+        if (llama_park_key_path(model->park_key) == path_model) {
+            return true;
+        }
+    }
+    return false;
+}
+
+llama_model * llama_model_park_cache_take(const std::string & key) {
+    std::lock_guard<std::mutex> lock(g_park_cache.mutex);
+    // a parked copy of the same file with another placement is stale: free it instead of keeping its pinned memory
+    for (auto it = g_park_cache.models.begin(); it != g_park_cache.models.end();) {
+        if ((*it)->park_key != key && llama_park_key_path((*it)->park_key) == llama_park_key_path(key)) {
+            LLAMA_LOG_WARN("%s: dropping a parked copy loaded with other settings\n", __func__);
+            delete *it;
+            it = g_park_cache.models.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    for (auto it = g_park_cache.models.begin(); it != g_park_cache.models.end(); ++it) {
+        if ((*it)->park_key == key) {
+            llama_model * model = *it;
+            g_park_cache.models.erase(it);
+            const int64_t t0 = ggml_time_us();
+            if (!model->unpark(g_park_cache.keep_pinned)) {
+                delete model;
+                return nullptr;
+            }
+            LLAMA_LOG_INFO("%s: model woken from park in %.2f s\n", __func__, (ggml_time_us() - t0) / 1e6);
+            model->woken = true;
+            return model;
+        }
+    }
+    return nullptr;
+}
+
 void llama_model_free(llama_model * model) {
+    if (model != nullptr && !model->park_key.empty()) {
+        std::lock_guard<std::mutex> lock(g_park_cache.mutex);
+        if (g_park_cache.enabled) {
+            const int64_t t0 = ggml_time_us();
+            if (model->park()) {
+                LLAMA_LOG_INFO("%s: model parked in host memory in %.2f s\n", __func__, (ggml_time_us() - t0) / 1e6);
+                g_park_cache.models.push_back(model);
+                return;
+            }
+            model->unpark();
+        }
+    }
     delete model;
 }
 
