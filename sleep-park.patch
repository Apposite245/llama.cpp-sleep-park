+// a 1-d view over a whole buffer, so that get/set calls can copy any byte range of it (padding included)
+static ggml_tensor llama_whole_buffer_view(ggml_backend_buffer_t buf, void * base, size_t size) {
+    ggml_tensor t = {};
+    t.type   = GGML_TYPE_I8;
+    t.ne[0]  = (int64_t) size;
+    t.ne[1]  = t.ne[2] = t.ne[3] = 1;
+    t.nb[0]  = 1;
+    t.nb[1]  = t.nb[2] = t.nb[3] = size;
+    t.buffer = buf;
+    t.data   = base;
+    return t;
+}
+
+// pinned host memory is kept in chunks: one huge transfer is slow on Windows, and unpinning chunks one by one later does not block the GPU for long
+static size_t llama_park_chunk() {
+    const char * env = getenv("LLAMA_PARK_CHUNK_MB");
+    const long long mb = env ? atoll(env) : 0;
+    return (size_t) (mb > 0 ? mb : 256) << 20;
+}
+
+bool llama_model::park() {
+    if (!pimpl->parked.empty()) {
+        return true;
+    }
+    const size_t chunk = llama_park_chunk();
+    for (size_t ci = 0; ci < pimpl->ctxs_bufs.size(); ci++) {
+        auto & [ctx, bufs] = pimpl->ctxs_bufs[ci];
+        for (size_t bi = 0; bi < bufs.size(); bi++) {
+            ggml_backend_buffer_t buf = bufs[bi].get();
+            if (buf == nullptr || ggml_backend_buffer_is_host(buf)) {
+                continue;
+            }
+            ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(buf);
+            ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+            ggml_backend_buffer_type_t host_buft = dev ? ggml_backend_dev_host_buffer_type(dev) : nullptr;
+            const size_t size = ggml_backend_buffer_get_size(buf);
+            if (host_buft == nullptr || size == 0) {
+                continue;
+            }
+            char * base = (char *) ggml_backend_buffer_get_base(buf);
+            ggml_tensor view = llama_whole_buffer_view(buf, base, size);
+            llama_model::impl::parked_buf p = { ci, bi, buft, size, {}, {} };
+            const int64_t t0 = ggml_time_us();
+            auto kept = pimpl->kept_hosts.find({ ci, bi });
+            if (kept != pimpl->kept_hosts.end()) {
+                p.hosts = std::move(kept->second);
+                pimpl->kept_hosts.erase(kept);
+            }
+            for (size_t i = 0, off = 0; off < size; i++, off += chunk) {
+                const size_t n = std::min(chunk, size - off);
+                if (i >= p.hosts.size()) {
+                    ggml_backend_buffer_ptr host(ggml_backend_buft_alloc_buffer(host_buft, n));
+                    if (!host) {
+                        LLAMA_LOG_ERROR("%s: failed to allocate %.2f MiB of pinned memory\n", __func__, n / 1024.0 / 1024.0);
+                        return false;
+                    }
+                    p.hosts.push_back(std::move(host));
+                }
+                ggml_backend_tensor_get(&view, ggml_backend_buffer_get_base(p.hosts[i].get()), off, n);
+            }
+            LLAMA_LOG_WARN("%s: %.2f GiB to pinned host memory in %.2f s\n", __func__, size / 1073741824.0, (ggml_time_us() - t0) / 1e6);
+            for (ggml_tensor * t = ggml_get_first_tensor(ctx.get()); t != nullptr; t = ggml_get_next_tensor(ctx.get(), t)) {
+                if (t->buffer == buf) {
+                    p.tensors.emplace_back(t, (size_t) ((char *) t->data - base));
+                    t->data   = nullptr;
+                    t->buffer = nullptr;
+                }
+            }
+            bufs[bi].reset();
+            pimpl->parked.push_back(std::move(p));
+        }
+    }
+    return true;
+}
+
+bool llama_model::unpark(bool keep_host) {
+    const size_t chunk = llama_park_chunk();
+    std::vector<ggml_backend_buffer_ptr> hosts;
+    for (auto & p : pimpl->parked) {
+        const int64_t t0 = ggml_time_us();
+        ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(p.buft, p.size);
+        if (buf == nullptr) {
+            LLAMA_LOG_ERROR("%s: failed to allocate %.2f MiB of device memory\n", __func__, p.size / 1024.0 / 1024.0);
+            return false;
+        }
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        char * base = (char *) ggml_backend_buffer_get_base(buf);
+        ggml_tensor view = llama_whole_buffer_view(buf, base, p.size);
+        for (size_t i = 0; i < p.hosts.size(); i++) {
+            const size_t off = i * chunk;
+            ggml_backend_tensor_set(&view, ggml_backend_buffer_get_base(p.hosts[i].get()), off, std::min(chunk, p.size - off));
+        }
+        LLAMA_LOG_WARN("%s: %.2f GiB back to the device in %.2f s\n", __func__, p.size / 1073741824.0, (ggml_time_us() - t0) / 1e6);
+        for (auto & [t, offs] : p.tensors) {
+            t->data   = base + offs;
+            t->buffer = buf;
+        }
+        pimpl->ctxs_bufs[p.ctx_idx].second[p.buf_idx].reset(buf);
+        if (keep_host) {
+            pimpl->kept_hosts[{ p.ctx_idx, p.buf_idx }] = std::move(p.hosts);
+            continue;
+        }
+        for (auto & h : p.hosts) {
+            hosts.push_back(std::move(h));
+        }
+    }
+    pimpl->parked.clear();
+    // unpin one chunk at a time with gaps, so that other GPU work is not held up while the memory is returned
+    std::thread([hosts = std::move(hosts)]() mutable {
+        for (auto & h : hosts) {
+            h.reset();
+            std::this_thread::sleep_for(std::chrono::milliseconds(5));
+        }
+    }).detach();
+    return true;
+}
+
+bool llama_model::is_parked() const {
+    return !pimpl->parked.empty();
+}
