+    }
+    ggml_backend_buffer_set_usage(ctx->buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    const char * host = (const char *) ggml_backend_buffer_get_base(ctx->parked_host.get());
+    for (auto & [t, off] : ctx->parked_tensors) {
+        ggml_backend_tensor_set(t, host + off, 0, ggml_nbytes(t));
+    }
+    ctx->parked_tensors.clear();
+    if (!keep_host) {
+        ctx->parked_host.reset();
+    }
+    return true;
+}
